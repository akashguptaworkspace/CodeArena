# Leave empty to run in local mode (progress saved in the browser, no sign-in).
# Set to your Node.js backend to enable Google sign-in and saved progress, e.g. http://localhost:4000
VITE_API_URL=

# Google OAuth Web client ID (the same value as GOOGLE_CLIENT_ID in codearena-backend/.env)
VITE_GOOGLE_CLIENT_ID=

# "true" locks paid modules unless the user owns them. Keep "false" until payments are live.
VITE_ENABLE_PAYWALL=false

# Public URL of the deployed site (no trailing slash). Used for link previews and share links.
VITE_APP_URL=https://your-domain.com

# Presence server (codearena-backend) for the live "online now" count. Empty = indicator hidden.
VITE_PRESENCE_URL=ws://localhost:4000/presence
